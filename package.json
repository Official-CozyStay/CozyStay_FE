{
  "name": "my-react-ts-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css}\"",
    "check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css}\" && eslint ."
  },
  "lint-staged": {
    "src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix"
    ],
    "src/**/*.{json,css}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@stomp/stompjs": "^7.3.0",
    "@tosspayments/tosspayments-sdk": "^2.6.0",
    "axios": "^1.13.2",
    "date-fns": "^4.1.0",
    "lucide-react": "^0.546.0",
    "react": "^19.1.1",
    "react-date-range": "^2.0.1",
    "react-day-picker": "^9.11.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.4",
    "sockjs-client": "^1.6.1",
    "styled-components": "^6.1.19",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@eslint/js": "^9.36.0",
    "@types/node": "^24.6.0",
    "@types/react": "^19.1.16",
    "@types/react-date-range": "^1.4.10",
    "@types/react-dom": "^19.1.9",
    "@types/sockjs-client": "^1.5.4",
    "@vitejs/plugin-react": "^5.0.4",
    "baseline-browser-mapping": "^2.9.11",
    "eslint": "^9.36.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.22",
    "globals": "^16.4.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "prettier": "^3.8.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.45.0",
    "vite": "^7.1.7"
  }
}
